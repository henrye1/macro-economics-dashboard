PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Cyte Core API passthrough. All five are required before /api/macro/* will
# answer; while any is blank those routes return 503 and /api/health still works.
# Secrets: set these in the Render dashboard, never in the repo.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
CORE_API_BASE_URL=

# Supabase Auth. The API verifies a visitor's access token against this
# project's public keys; it needs no secret of its own and no service key.
# While this is blank /api/macro/* returns 503 rather than falling open.
# The project must use asymmetric JWT signing keys: a non-empty `keys` array at
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json. The legacy HS256 secret is
# not supported.
#
# The console needs the same URL plus the anon (publishable) key, never the
# service_role key. They are not env vars: set `supabaseUrl` and
# `supabaseAnonKey` in ui/src/environments/environment.ts for development and
# in environment.production.ts for the production build, which never reads the
# development file.
SUPABASE_URL=
